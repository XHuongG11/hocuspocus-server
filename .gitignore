.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Whether you use PnP or not, the node_modules folder is often used to store
# build artifacts that should be gitignored
node_modules

# Swap the comments on the following lines if you wish to use zero-installs
# In that case, don't forget to run `yarn config set enableGlobalCache false`!
# Documentation here: https://yarnpkg.com/features/caching#zero-installs

#!.yarn/cache
.pnp.*
.gitnexus

# Environment files (contain secrets — never commit)
.env
.env.*
!.env.example

# AI coding assistants / agent tooling (keep private)
.claude/
.codex/
.agents/
.cursor/
.cursorrules
.windsurf/
.aider*
.continue/
.roo/
.codeium/
.gemini/
.playwright-mcp/
.mcp.json
.gitnexus
openspec/
.github/prompts/
.github/chatmodes/
.github/copilot-instructions.md
CLAUDE.md
CLAUDE.local.md
